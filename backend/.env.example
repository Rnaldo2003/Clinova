# Copia este archivo como  .env  y pon tus datos reales de MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=clinnova

# MongoDB (mensajes, notificaciones y bitácora)
MONGO_URI=mongodb://127.0.0.1:27017/clinnova

# Puerto donde corre la API
PORT=4000

# Clave secreta para los tokens de sesión (cámbiala por cualquier texto largo)
JWT_SECRET=pon_aqui_un_texto_largo_y_secreto

# Dirección del sistema (se usa en los enlaces de "recuperar contraseña")
APP_URL=http://localhost:4000

# Correo para enviar los enlaces de recuperación (OPCIONAL).
# Si lo dejas vacío, el enlace se muestra en la terminal donde corre la API.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
